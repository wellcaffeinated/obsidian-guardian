# Conventional Commits, enforced at the source.
#
# CLAUDE.md documents the convention and release-please depends on it: a
# malformed subject isn't rejected downstream, it's silently miscategorised in
# the changelog (or drops out of it entirely, taking the version bump with it).
# Cheaper to catch here than to fix a release afterwards.

msg_file="$1"
# First non-comment, non-empty line — the header.
header=$(grep -v '^#' "$msg_file" | grep -v '^[[:space:]]*$' | head -n 1)

# Merges, reverts and rebase fixups are generated by git itself; leave them be.
case "$header" in
  "Merge "* | "Revert "* | "fixup!"* | "squash!"*) exit 0 ;;
esac

types='build|chore|ci|deps|docs|feat|fix|perf|refactor|revert|style|test'

if ! printf '%s' "$header" | grep -qE "^($types)(\([a-z0-9./-]+(,[a-z0-9./-]+)*\))?!?: .+"; then
  echo "✗ Commit message must follow Conventional Commits." >&2
  echo "    got:      $header" >&2
  echo "    expected: <type>[(scope)][!]: <subject>" >&2
  echo "    types:    $(printf '%s' "$types" | tr '|' ' ')" >&2
  echo "    example:  fix(plugin): evict stale per-file diffs" >&2
  exit 1
fi

if [ "${#header}" -gt 72 ]; then
  echo "✗ Commit subject is ${#header} characters; keep it to 72." >&2
  echo "    Detail belongs in the body, which has no limit." >&2
  exit 1
fi

case "$header" in
  *.) echo "✗ Commit subject must not end with a period." >&2; exit 1 ;;
esac
