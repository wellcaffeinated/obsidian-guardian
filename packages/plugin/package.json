{
  "name": "@obsidian-guardian/plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Obsidian plugin adapter over the Obsidian Guardian engine: a vault-wide review panel with bless/rollback.",
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint:obsidian": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@isomorphic-git/lightning-fs": "^4.6.2",
    "@obsidian-guardian/engine": "workspace:*",
    "buffer": "^6.0.3",
    "isomorphic-git": "^1.27.1",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "fake-indexeddb": "^6.2.5",
    "obsidian": "^1.13.0",
    "tsdown": "^0.21.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.4"
  }
}
